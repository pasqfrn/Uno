<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Uno" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/uno" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/uno" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
			<Target title="Test">
				<Option output="tests/test_adt" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Test/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-Itests/stubs" />
				</Compiler>
				<Linker>
					<Add option="-lm" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add directory="lib/raylib/include" />
			<Add directory="lib" />
			<Add directory="src" />
		</Compiler>
		<Linker>
			<Add option="-lraylib" />
			<Add option="-lopengl32" />
			<Add option="-lgdi32" />
			<Add option="-lwinmm" />
			<Add option="-lws2_32" />
			<Add library="lib/raylib/lib/libraylib.a" />
			<Add library="lib/raylib/lib/libraylibdll.a" />
			<Add directory="lib/raylib/lib" />
		</Linker>
