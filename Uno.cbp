				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
			<Target title="Test">
				<Option output="Test" prefix_auto="1" extension_auto="1" />
				<Option object_output=".objs/test" />
				<Option type="1" />
				<Option compiler="gcc" />
			</Target>
		</Build>
		<Compiler>
